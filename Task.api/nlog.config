<?xml version="1.0" encoding="utf-8" ?>
<!-- GN-06-R2: NLog settings. Levels per category come from Logging:LogLevel in appsettings (Debug in development only). -->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      throwConfigExceptions="true">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <variable name="line"
            value="${longdate}|${level:uppercase=true}|${logger}|${scopeproperty:CorrelationId}|${message}${onexception:inner= ${exception:format=tostring}}" />

  <targets>
    <!-- GN-06-R4: always on, so the logs show in Docker and Render -->
    <target name="console" xsi:type="Console" layout="${line}" />

    <!-- GN-06-R4: development only -->
    <target name="file" xsi:type="File" layout="${line}"
            fileName="${basedir}/logs/taskapi-${shortdate}.log"
            maxArchiveDays="7" />
  </targets>

  <rules>
    <logger name="*" minlevel="Trace" writeTo="console" />
    <logger name="*" minlevel="Trace" writeTo="file">
      <filters defaultAction="Ignore">
        <when condition="'${aspnet-environment}' == 'Development'" action="Log" />
      </filters>
    </logger>
  </rules>
</nlog>
